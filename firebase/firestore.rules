rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /encuestas/{document} {
      allow read: if request.auth != null || resource.data.get('active', true) == true;
      allow create, update, delete: if request.auth != null;
    }

    match /votos/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /voto_dispositivo/{document} {
      allow get, create: if true;
      allow list, update, delete: if request.auth != null;
    }

    match /resultados_encuestas/{document} {
      allow read: if true;
      allow write: if true;
    }

    match /noticias/{document} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /contenido/{document} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

  }
}
